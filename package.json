{
  "name": "beecrm",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @beecrm/api db:migrate",
    "infra:up": "docker compose up -d postgres valkey mailpit",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
